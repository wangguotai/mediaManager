# ============================================================
# Media Manager 部署环境变量模板
# 用法： cp .env.example .env  &&  编辑 .env  &&  ./deploy.sh
# 或：   docker compose --env-file .env up -d
# ============================================================

# ---- 后端 (media-server) ----

# [必填] JWT HS256 签名密钥。生产环境必须用一段足够随机的长字符串（建议 ≥32 字节）。
# 留空则进程启动时生成内存随机密钥——重启后失效，所有已签发 token 作废，仅适合开发。
# 生成建议： openssl rand -hex 32
MM_JWT_SECRET=

# [可选] REST gateway 对外端口（容器内固定 8080，此变量控制宿主机映射）。默认 8080。
MM_PORT=8080

# [可选] JWT token 有效期（秒）。默认 604800（7 天）。
MM_JWT_TTL_SECONDS=604800

# [可选] 注册端点开放模式：
#   off    禁止自助注册（最安全，需管理员建号）
#   first  仅在 user 表为空时允许注册首个账号（自动 admin），其后关闭 —— 推荐冷启动
#   open   任意人可注册（角色固定 user）
MM_ALLOW_SIGNUP=first

# [可选] 首次启动超管用户名。留空默认 admin。
MM_BOOTSTRAP_ADMIN_USERNAME=admin

# [可选] 首次启动超管密码。留空则自动生成一次性随机密码，
# 并在 docker logs 中打印 INITIAL ADMIN token（用 token 首次登录后改密）。
MM_BOOTSTRAP_ADMIN_PASSWORD=

# ---- 运营服务端 (ops-server) ----

# [必填] ops-server JWT 密钥。同上，生产必须用强随机串。
MM_OPS_JWT_SECRET=

# [可选] ops-server HTTP 端口映射。默认 8090。
MM_OPS_HTTP_PORT=8090

# [可选] ops-server TCP 中继端口映射。默认 18791。
# 注：原 18790 与同机 OpenClaw gateway 冲突，故默认避让到 18791。
MM_OPS_RELAY_PORT=18791

# [可选] ops-server token 有效期（秒）。默认 604800（7 天）。
MM_OPS_JWT_TTL_SECONDS=604800

# [可选] 首次启动创建首位 admin（格式 user:pass）。已存在则跳过。
MM_OPS_BOOTSTRAP_ADMIN=admin:admin123

# [可选] ops-server 注册模式：first（首位即 admin，默认）/ off（关闭注册）。
MM_OPS_SIGNUP_MODE=first
