# ops-server 环境变量配置示例。
#
# ops-server 不读 yaml 配置文件，全部配置走 MM_OPS_* 环境变量
# （见 internal/config/config.go 与 cmd/ops-server/main.go）。
#
# 用法：
#   cp .env.example .env
#   按需修改 .env，再 `docker compose up -d --build`
#
# 注意：docker-compose.yml 的 environment 段会覆盖 .env 中同名变量（用于固定容器内路径）。
#       因此监听地址/数据目录建议保持 .env 不动或同步修改两处；JWT/bootstrap 等运行参数放 .env 即可。

# —— 网络 ——
# HTTP 监听地址（REST/admin + /healthz）。容器内固定 :8090，与端口映射一致。
# 修改时需同步 docker-compose.yml 的 ports 与 environment。
MM_OPS_HTTP_ADDR=:8090

# TCP 中继监听地址（TURN 式转发）。默认 :18791（避让同机 OpenClaw gateway 的 :18790）。
MM_OPS_RELAY_ADDR=:18791

# —— 存储 ——
# 数据目录：SQLite 库 + 会话状态文件。容器内固定 /data（由命名卷挂载）。
# 修改会破坏卷挂载，生产环境请勿改。
MM_OPS_DATA_DIR=/data

# SQLite 数据库路径。留空则用 ${MM_OPS_DATA_DIR}/ops.db。
# MM_OPS_DB_PATH=/data/ops.db

# —— 认证 ——
# JWT HS256 签名密钥。生产环境【必填】，留空则进程级随机（重启即失效，所有已发 token 作废）。
# 建议用 `openssl rand -hex 32` 生成 64 位 hex。
MM_OPS_JWT_SECRET=

# JWT 有效期（秒）。默认 7 天（604800）。
# MM_OPS_JWT_TTL_SECONDS=604800

# 注册模式：first=首位注册者即 admin（默认）；off=关闭注册。
# 见 cmd/ops-server/main.go 的 MM_OPS_SIGNUP_MODE。
MM_OPS_SIGNUP_MODE=first

# 首位 admin bootstrap，格式 "user:pass"。仅首次启动、无任何账号时创建；已存在则跳过。
# 适合首次部署快速创建管理员。去掉注释并填值后启用。
# MM_OPS_BOOTSTRAP_ADMIN=admin:change-me

# —— 日志 ——
# 中继日志是否记录字节计数（默认 true）。设 0/false/no/off 关闭。
# MM_OPS_LOG_BYTES_VERBOSE=true
