# ============================================================
# Media Manager 后端环境变量模板
# 用法：
#   本地开发： cp .env.example .env  &&  按需修改  &&  source .env && go run ./cmd/server
#   Docker：   在 docker-compose.yml 的 environment 段引用同名变量。
#
# 覆盖优先级：代码默认 < config.yaml < MM_* 环境变量
# ============================================================

# [必填/生产] JWT HS256 签名密钥。
# 生产环境必须用一段足够随机的长字符串（≥32 字节）。
# 留空则进程启动时生成内存随机密钥——重启失效，所有已签发 token 作废，仅适合开发。
# 生成建议： openssl rand -hex 32
MM_JWT_SECRET=

# REST gateway 监听端口（容器内固定 8080，本地直跑可改）。默认 8080。
MM_PORT=8080

# 数据根目录。其下含 users/<uid>/、cloud-images/、media.db 等。
# 容器内建议 /app/data；本地开发用 ./data。
MM_DATA_DIR=./data

# SQLite 元数据库文件路径。留空时自动派生为 <MM_DATA_DIR>/media.db。
MM_DB_PATH=./data/media.db

# JWT token 有效期（秒）。默认 604800（7 天）。
MM_JWT_TTL_SECONDS=604800

# 注册端点开放模式：
#   off    禁止自助注册（最安全，需管理员建号）
#   first  仅在 user 表为空时允许注册首个账号（自动 admin），其后关闭 —— 推荐冷启动
#   open   任意人可注册（角色固定 user）
MM_ALLOW_SIGNUP=first

# 运维管理面 / ops-server 地址，供 POST /api/openclaw/command 转发 +
# backend 启动自动注册并维持 WS 长连。留空则桥接端点返回 502，不影响媒体主功能。
# Docker Compose 联合部署时用 http://ops-server:8090（service 名即主机名）。
MM_OPS_SERVER_URL=http://ops-server:8090

# ---- 首次启动超管引导（可选）----
# 留空时用户名默认 admin、密码自动生成一次性随机串（见启动日志 INITIAL ADMIN 段）。
# 显式指定则用给定凭据创建超管；仅库为空时生效，重启幂等跳过。
MM_BOOTSTRAP_ADMIN_USERNAME=admin
MM_BOOTSTRAP_ADMIN_PASSWORD=
